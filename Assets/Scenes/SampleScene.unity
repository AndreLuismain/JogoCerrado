  m_Script: {fileID: 11500000, guid: a64c4a68317146f43a3c9329333bff86, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cerrado.Interaction.GuideNPC
  interactionDistance: 3.5
  npcName: "Prof. Silva (Bi\xF3logo do Cerrado)"
  dialogueLines:
  - "Bem-vindo ao Cerrado brasileiro! O segundo maior bioma do nosso pa\xEDs e lar de milhares de esp\xE9cies \xFAnicas."
  - "Como fot\xF3grafo e pesquisador de campo, sua miss\xE3o \xE9 catalogar nossa fauna e flora no \xC1lbum da expedi\xE7\xE3o."
  - "Dica de ouro: Segure o BOT\xC3O DIREITO do mouse para olhar pelo visor da c\xE2mera e use a RODINHA do mouse para zoom."
  - "Aproxime-se AGACHADO (Ctrl) para n\xE3o assustar esp\xE9cies velozes como a Ema, e clique no BOT\xC3O ESQUERDO para fotografar."
  - "Consulte suas miss\xF5es ativas na tela e venha falar comigo sempre que precisar de orienta\xE7\xE3o!"
  promptUI: {fileID: 529904723}
  dialoguePanel: {fileID: 2106422460}
  dialogueSpeakerText: {fileID: 250808656}
  dialogueBodyText: {fileID: 15727291}
